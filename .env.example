# ============================================================
# 供应链溯源系统 - 环境变量模板
# 复制为 .env 并填入你的真实配置
# 部署命令: cp .env.example .env && vim .env
# ============================================================

# MySQL root 密码（必填，请修改为高强度密码）
MYSQL_ROOT_PASSWORD=请修改为你的密码

# 应用端口（宿主机映射端口，80 为默认 HTTP 端口）
APP_PORT=80

# Gin 运行模式: debug / release（生产环境务必用 release）
GIN_MODE=release

# JWT 签名密钥（生产环境务必随机生成，影响所有已签发 token！）
# 生成方法: openssl rand -base64 32
JWT_SECRET=请修改为随机密钥

# ============================================================
# 数据库连接（以下变量覆盖 config.yaml，Docker 部署时会自动设置）
# 本地开发无需修改，Docker Compose 会自动填充
# ============================================================
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=root
# DB_NAME=supply_chain
# DB_PASSWORD=${MYSQL_ROOT_PASSWORD}

# ============================================================
# 外部访问说明
# ============================================================
# 1. 阿里云安全组：确保入方向允许 80 端口（如需 HTTPS 还需 443）
# 2. 访问地址：http://<阿里云公网IP>:80
# 3. 如使用域名：配置 DNS A 记录指向服务器 IP，并修改 nginx.conf 的 server_name
