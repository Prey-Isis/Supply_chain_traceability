# ============================================================
# 供应链溯源系统 - 环境变量模板
# 复制为 .env 并填入你的真实配置
# ============================================================

# MySQL root 密码（必填）
MYSQL_ROOT_PASSWORD=请修改为你的密码

# 应用端口（宿主机映射端口）
APP_PORT=80

# Gin 运行模式: debug / release
GIN_MODE=release

# JWT 签名密钥（生产环境务必随机生成）
# 生成方法: openssl rand -base64 32
JWT_SECRET=请修改为随机密钥
