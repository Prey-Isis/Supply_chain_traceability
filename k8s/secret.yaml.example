# ============================================================================
# K8s 本地部署 - 密钥清单（示例模板）
# ----------------------------------------------------------------------------
# 【这是什么？】
#   Secret = K8s 里专门存密码/密钥的资源。Pod 通过 secretKeyRef 引用里面的值，
#   这样密码就不会明文散落在各个 Deployment 的 YAML 里。
#
# 【怎么用？】
#   cp secret.yaml.example secret.yaml   # 然后按需修改
#   kubectl apply -f secret.yaml
#
# ⚠️ secret.yaml 已加入 .gitignore（含密码，绝对不能提交到 GitHub）。
#    本文件（example）只放占位值，可以提交。
#    本地开发用下面这组默认值即可；生产环境务必全部换成强密码。
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: supply-chain-secret   # 其他 YAML 通过这个名字引用
  namespace: default
type: Opaque
# stringData：直接写明文，K8s 会自动编码（比 data 字段的 base64 对新手友好）
stringData:
  MYSQL_ROOT_PASSWORD: SupplyChain@2024
  RABBITMQ_USER: supply_mq
  RABBITMQ_PASSWORD: SupplyMQ@2024
  JWT_SECRET: local-dev-jwt-secret-key
